# Example Apache rules if the site is ever served behind Apache.
# GitHub Pages does not read .htaccess — use Cloudflare/page rules or nginx instead.

RewriteEngine On

# Permanent redirect: /index.html → /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Optional: strip tracking of legacy query deep-links is NOT done here.
# Keep ?part= / ?lang= reachable for UX; HTML canonical points to the clean URL.
